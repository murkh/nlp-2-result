# Multi-Stage Production Dockerfile for Streamlit Frontend
# Stage 1: Build & Dependency Resolution
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system build dependencies and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager and create virtual environment
RUN pip install --no-cache-dir uv && \
    uv venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

# Install frontend dependencies into virtual environment
RUN uv pip install --python /opt/venv/bin/python \
    "streamlit>=1.37.0" \
    "httpx>=0.27.0" \
    "pandas>=2.2.2" \
    "pyarrow>=17.0.0" \
    "openpyxl>=3.1.5"

# Stage 2: Minimal Runtime Image
FROM python:3.11-slim AS runner

WORKDIR /app

# Install curl for container healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Copy frontend source code
COPY frontend/ ./frontend/

EXPOSE 8501

# Healthcheck to ensure Streamlit server is responding
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=5s \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "frontend/ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
